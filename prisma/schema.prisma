generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccessRole {
  OWNER
  ADMIN
  OPERATIONS_MANAGER
  SALES_MANAGER
  FINANCE_MANAGER
  MEMBER
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACTOR
  INTERN
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
}

enum ProjectMemberRole {
  PROJECT_LEAD
  MANAGER
  CONTRIBUTOR
  VIEWER
}

enum ProjectPhaseStatus {
  PLANNED
  ACTIVE
  BLOCKED
  COMPLETED
  CANCELLED
}

enum TaskParticipantRole {
  OWNER
  CONTRIBUTOR
  REVIEWER
  OBSERVER
}

enum TaskDependencyType {
  FINISH_TO_START
  START_TO_START
  FINISH_TO_FINISH
  START_TO_FINISH
}

enum TaskBlockerSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskBlockerStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum ActivityAction {
  LOGIN
  LOGOUT
  USER_CREATED
  USER_UPDATED
  USER_DEACTIVATED
  USER_ACTIVATED
  COMPANY_UPDATED
  NOTIFICATION_READ
  NOTIFICATIONS_READ_ALL
  FILE_UPLOADED
  CLIENT_CREATED
  CLIENT_UPDATED
  CLIENT_ARCHIVED
  CLIENT_RESTORED
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_ARCHIVED
  PROJECT_RESTORED
  PROJECT_COMPLETED
  TASK_CREATED
  TASK_UPDATED
  TASK_COMPLETED
  TASK_ARCHIVED
  TASK_RESTORED
  SERVICE_REQUEST_CREATED
  SERVICE_REQUEST_UPDATED
  SERVICE_REQUEST_CONTACTED
  SERVICE_REQUEST_PROPOSAL_SENT
  SERVICE_REQUEST_APPROVED
  SERVICE_REQUEST_REJECTED
  SERVICE_REQUEST_CONVERTED
  SERVICE_REQUEST_ARCHIVED
  SERVICE_REQUEST_RESTORED
  EMPLOYEE_PROFILE_UPDATED
  DEPARTMENT_CREATED
  DEPARTMENT_UPDATED
  JOB_ROLE_CREATED
  JOB_ROLE_UPDATED
  TEAM_CREATED
  TEAM_UPDATED
  TEAM_MEMBERSHIP_UPDATED
  TEAM_MEMBERSHIP_REMOVED
  PROJECT_MEMBER_ADDED
  PROJECT_MEMBER_UPDATED
  PROJECT_MEMBER_REMOVED
  PROJECT_PHASE_CREATED
  PROJECT_PHASE_UPDATED
  PROJECT_PHASE_REMOVED
  TASK_PARTICIPANT_ADDED
  TASK_PARTICIPANT_UPDATED
  TASK_PARTICIPANT_REMOVED
  TASK_DEPENDENCY_ADDED
  TASK_DEPENDENCY_REMOVED
  TASK_BLOCKER_CREATED
  TASK_BLOCKER_UPDATED
  TASK_BLOCKER_RESOLVED
}

model Company {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  email    String?
  phone    String?
  website  String?
  logoUrl  String?
  address  String?
  country  String    @default("Jordan")
  currency String    @default("JOD")
  timezone String    @default("Asia/Amman")
  language String    @default("ar")
  clients  Client[]
  projects Project[]
  tasks    Task[]

  users            User[]
  sessions         Session[]
  activities       ActivityLog[]
  notifications    Notification[]
  files            File[]
  departments      Department[]
  jobRoles         JobRole[]
  employeeProfiles EmployeeProfile[]
  teams            Team[]
  teamMemberships  TeamMembership[]
  projectMembers   ProjectMember[]
  projectPhases    ProjectPhase[]
  taskParticipants TaskParticipant[]
  taskDependencies TaskDependency[]
  taskBlockers     TaskBlocker[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  serviceRequests ServiceRequest[]
}

model User {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name         String
  email        String     @unique
  passwordHash String
  role         AccessRole @default(MEMBER)
  isActive     Boolean    @default(true)

  lastLoginAt DateTime?

  sessions      Session[]
  activities    ActivityLog[]
  notifications Notification[]
  uploadedFiles File[]

  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  assignedTasks           Task[]           @relation("TaskAssignee")
  createdTasks            Task[]           @relation("TaskCreator")
  assignedServiceRequests ServiceRequest[] @relation("ServiceRequestAssignee")
  employeeProfile         EmployeeProfile?
  reportedTaskBlockers    TaskBlocker[]    @relation("TaskBlockerReporter")
  resolvedTaskBlockers    TaskBlocker[]    @relation("TaskBlockerResolver")

  @@index([companyId])
  @@index([role])
  @@index([isActive])
}

model Session {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String  @unique
  isActive  Boolean @default(true)

  ipAddress String?
  userAgent String?

  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([userId])
  @@index([isActive])
  @@index([expiresAt])
}

model RateLimitBucket {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime
  expiresAt   DateTime
  updatedAt   DateTime @updatedAt

  @@index([expiresAt])
}

model Department {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name        String
  code        String
  description String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  leadProfileId String?
  leadProfile   EmployeeProfile? @relation("DepartmentLead", fields: [leadProfileId], references: [id], onDelete: SetNull)

  employeeProfiles EmployeeProfile[]
  jobRoles         JobRole[]
  teams            Team[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@index([leadProfileId])
  @@index([isActive])
  @@index([sortOrder])
}

model JobRole {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  name        String
  code        String
  description String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  employeeProfiles EmployeeProfile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@index([departmentId])
  @@index([isActive])
  @@index([sortOrder])
}

model EmployeeProfile {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  employeeNumber String?

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  jobRoleId String?
  jobRole   JobRole? @relation(fields: [jobRoleId], references: [id], onDelete: SetNull)

  managerId String?
  manager   EmployeeProfile?  @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports   EmployeeProfile[] @relation("EmployeeManager")

  employmentType   EmploymentType   @default(FULL_TIME)
  status           EmploymentStatus @default(ACTIVE)
  phone            String?
  location         String?
  workHoursPerWeek Decimal          @default(40) @db.Decimal(5, 2)
  startDate        DateTime?
  endDate          DateTime?

  teamMemberships   TeamMembership[]
  projectMemberships ProjectMember[]
  taskParticipations  TaskParticipant[]
  ledDepartments      Department[]     @relation("DepartmentLead")
  ledTeams            Team[]           @relation("TeamLead")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, employeeNumber])
  @@index([companyId])
  @@index([departmentId])
  @@index([jobRoleId])
  @@index([managerId])
  @@index([status])
}

model Team {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  leadProfileId String?
  leadProfile   EmployeeProfile? @relation("TeamLead", fields: [leadProfileId], references: [id], onDelete: SetNull)

  name        String
  code        String
  description String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  memberships TeamMembership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@index([departmentId])
  @@index([leadProfileId])
  @@index([isActive])
  @@index([sortOrder])
}

model TeamMembership {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  employeeProfileId String
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  allocationPercent Int     @default(100)
  responsibility    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, employeeProfileId])
  @@index([companyId])
  @@index([employeeProfileId])
}

model ActivityLog {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action     ActivityAction
  entityType String?
  entityId   String?
  message    String?
  metadata   Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model Notification {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title   String
  message String
  type    NotificationType @default(INFO)
  isRead  Boolean          @default(false)

  entityType String?
  entityId   String?

  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([companyId])
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model File {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  name     String
  url      String
  mimeType String?
  size     Int?

  entityType String?
  entityId   String?

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([uploadedById])
  @@index([entityType, entityId])
}

model Client {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name    String
  email   String?
  phone   String?
  website String?

  type   ClientType   @default(COMPANY)
  status ClientStatus @default(LEAD)
  source LeadSource   @default(OTHER)

  industry String?
  country  String?
  city     String?

  notes    String?
  projects Project[]
  tasks    Task[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  serviceRequests ServiceRequest[]

  @@index([companyId])
  @@index([status])
  @@index([type])
  @@index([source])
  @@index([createdAt])
}

model Project {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  name        String
  code        String?
  description String?

  status   ProjectStatus   @default(PLANNING)
  priority ProjectPriority @default(MEDIUM)

  budget          Decimal?         @db.Decimal(12, 2)
  currency        String           @default("JOD")
  serviceRequests ServiceRequest[]

  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?
  tasks       Task[]
  members     ProjectMember[]
  phases      ProjectPhase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([clientId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

model Task {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  phaseId String?
  phase   ProjectPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  assignedToId String?
  assignedTo   User?   @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  title       String
  description String?

  status   TaskStatus   @default(TODO)
  priority TaskPriority @default(MEDIUM)
  source   TaskSource   @default(MANUAL)

  sourceRef      String?
  estimatedHours Decimal? @db.Decimal(8, 2)
  sortOrder      Int      @default(0)
  progress       Int      @default(0)

  dueDate     DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  participants TaskParticipant[]
  dependencies TaskDependency[] @relation("TaskDependencies")
  dependents   TaskDependency[] @relation("TaskDependents")
  blockers     TaskBlocker[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([projectId])
  @@index([phaseId])
  @@index([clientId])
  @@index([assignedToId])
  @@index([createdById])
  @@index([status])
  @@index([priority])
  @@index([source])
  @@index([dueDate])
  @@index([createdAt])
}

model ProjectMember {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  employeeProfileId String
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  role           ProjectMemberRole @default(CONTRIBUTOR)
  responsibility String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, employeeProfileId])
  @@index([companyId])
  @@index([employeeProfileId])
  @@index([role])
}

model ProjectPhase {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name        String
  code        String?
  description String?
  status      ProjectPhaseStatus @default(PLANNED)
  progress    Int                @default(0)
  sortOrder   Int                @default(0)

  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?

  tasks Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, code])
  @@index([companyId])
  @@index([projectId])
  @@index([status])
  @@index([sortOrder])
}

model TaskParticipant {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  employeeProfileId String
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  role TaskParticipantRole @default(CONTRIBUTOR)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taskId, employeeProfileId])
  @@index([companyId])
  @@index([employeeProfileId])
  @@index([role])
}

model TaskDependency {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  taskId String
  task   Task   @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)

  dependsOnTaskId String
  dependsOnTask   Task   @relation("TaskDependents", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  type TaskDependencyType @default(FINISH_TO_START)

  createdAt DateTime @default(now())

  @@unique([taskId, dependsOnTaskId])
  @@index([companyId])
  @@index([dependsOnTaskId])
}

model TaskBlocker {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  reportedById String?
  reportedBy   User?   @relation("TaskBlockerReporter", fields: [reportedById], references: [id], onDelete: SetNull)

  resolvedById String?
  resolvedBy   User?   @relation("TaskBlockerResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  title       String
  description String?
  severity    TaskBlockerSeverity @default(MEDIUM)
  status      TaskBlockerStatus   @default(OPEN)
  resolution  String?

  resolvedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([companyId])
  @@index([taskId])
  @@index([reportedById])
  @@index([resolvedById])
  @@index([status])
  @@index([severity])
}

model ServiceRequest {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  assignedToId String?
  assignedTo   User?   @relation("ServiceRequestAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  customerName    String
  customerEmail   String?
  customerPhone   String?
  customerCompany String?

  serviceType String
  budgetRange String?
  timeline    String?
  message     String?

  status   ServiceRequestStatus   @default(NEW)
  source   ServiceRequestSource   @default(WEBSITE)
  priority ServiceRequestPriority @default(MEDIUM)

  workflowRunId  String?
  idempotencyKey String?
  proposalUrl    String?

  proposalSentAt DateTime?
  approvedAt     DateTime?
  rejectedAt     DateTime?
  convertedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, idempotencyKey])
  @@index([companyId])
  @@index([clientId])
  @@index([projectId])
  @@index([assignedToId])
  @@index([status])
  @@index([source])
  @@index([priority])
  @@index([createdAt])
}

enum ClientType {
  COMPANY
  INDIVIDUAL
}

enum ClientStatus {
  LEAD
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum LeadSource {
  WEBSITE
  FACEBOOK
  INSTAGRAM
  WHATSAPP
  REFERRAL
  DIRECT
  OTHER
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  REVIEW
  DONE
  CANCELLED
  ARCHIVED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskSource {
  MANUAL
  WEBSITE_REQUEST
  WORKFLOW
  AI_GENERATED
}

enum ServiceRequestStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  APPROVED
  REJECTED
  CONVERTED
  ARCHIVED
}

enum ServiceRequestSource {
  WEBSITE
  MANUAL
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  REFERRAL
  OTHER
}

enum ServiceRequestPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
