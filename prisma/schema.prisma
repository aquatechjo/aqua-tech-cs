  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([opportunityId])
  @@index([createdById])
  @@index([type])
  @@index([status])
  @@index([scheduledAt])
  @@index([completedAt])
}

model SalesProposal {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  opportunityId String
  opportunity   SalesOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User? @relation("SalesProposalCreator", fields: [createdById], references: [id], onDelete: SetNull)

  proposalNumber String
  version        Int
  status         SalesProposalStatus @default(DRAFT)
  title          String
  amount         Decimal @db.Decimal(14, 2)
  currency       String  @default("JOD")

  validUntil DateTime?
  url        String?
  notes      String?

  sentAt     DateTime?
  acceptedAt DateTime?
  rejectedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, proposalNumber])
  @@unique([opportunityId, version])
  @@index([companyId])
  @@index([opportunityId])
  @@index([createdById])
  @@index([status])
  @@index([validUntil])
}

