model Company {
  id             String          @id @default(cuid())
  name           String
  slug           String          @unique
  email          String?
  phone          String?
  website        String?
  logoUrl        String?
  address        String?
  country        String          @default("Jordan")
  currency       String          @default("JOD")
  timezone       String          @default("Asia/Amman")
  language       String          @default("ar")
  clients        Client[]
  clientContacts ClientContact[]
  projects       Project[]
  tasks          Task[]

  users                   User[]
  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  activities              ActivityLog[]
  notifications           Notification[]
  files                   File[]
  departments             Department[]
  jobRoles                JobRole[]
  employeeProfiles        EmployeeProfile[]
  teams                   Team[]
  teamMemberships         TeamMembership[]
  projectMembers          ProjectMember[]
  projectPhases           ProjectPhase[]
  workflowTemplates       WorkflowTemplate[]
  projectWorkflows        ProjectWorkflow[]
  projectReadinessGates   ProjectReadiness[]
  projectDeliverables     ProjectDeliverable[]
  projectChangeRequests   ProjectChangeRequest[]
  projectChangeItems      ProjectChangeRequestItem[]
  projectGovernanceItems  ProjectGovernanceItem[]
  projectClosures         ProjectClosure[]
  projectFeedback         ProjectFeedback[]
  workflowApprovals       ProjectWorkflowApproval[]
  workflowRules           ProjectWorkflowRule[]
  workflowEvents          WorkflowEvent[]
  taskParticipants        TaskParticipant[]
  taskDependencies        TaskDependency[]
  taskBlockers            TaskBlocker[]
  invoices                Invoice[]
  invoiceItems            InvoiceItem[]
  payments                Payment[]
  expenses                Expense[]
  documentSequences       DocumentSequence[]
  salesOpportunities      SalesOpportunity[]
  salesActivities         SalesActivity[]
  salesProposals          SalesProposal[]
  leads                   Lead[]
  intakeSessions          IntakeSession[]
  intakeAnswers           IntakeAnswer[]
  requirementGaps         RequirementGap[]
  conversationMessages    ConversationMessage[]
  discoveryReports        DiscoveryReport[]
  discoveryReportVersions DiscoveryReportVersion[]
  pricingWorkspaces       PricingWorkspace[]
  pricingVersions         PricingVersion[]
  proposalWorkspaces      ProposalWorkspace[]
  proposalVersions        ProposalVersion[]
  proposalDeliveries      ProposalDelivery[]
  proposalClientResponses ProposalClientResponse[]
  timeEntries             TimeEntry[]
  timesheets              Timesheet[]
  workSchedules           WorkSchedule[]
  attendanceRecords       AttendanceRecord[]
  leaveTypes              LeaveType[]
  leaveBalances           LeaveBalance[]
  leaveRequests           LeaveRequest[]
  publicHolidays          PublicHoliday[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  serviceRequests ServiceRequest[]
}

model User {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name         String
  email        String     @unique
  passwordHash String
  role         AccessRole @default(MEMBER)
  isActive     Boolean    @default(true)

  lastLoginAt DateTime?

  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  activities          ActivityLog[]
  notifications       Notification[]
  uploadedFiles       File[]

  createdAt                     DateTime                 @default(now())
  updatedAt                     DateTime                 @updatedAt
  assignedTasks                 Task[]                   @relation("TaskAssignee")
  createdTasks                  Task[]                   @relation("TaskCreator")
  assignedServiceRequests       ServiceRequest[]         @relation("ServiceRequestAssignee")
  employeeProfile               EmployeeProfile?
  reportedTaskBlockers          TaskBlocker[]            @relation("TaskBlockerReporter")
  resolvedTaskBlockers          TaskBlocker[]            @relation("TaskBlockerResolver")
  createdInvoices               Invoice[]                @relation("InvoiceCreator")
  recordedPayments              Payment[]                @relation("PaymentRecorder")
  reversedPayments              Payment[]                @relation("PaymentReverser")
  createdExpenses               Expense[]                @relation("ExpenseCreator")
  approvedExpenses              Expense[]                @relation("ExpenseApprover")
  ownedSalesOpportunities       SalesOpportunity[]       @relation("SalesOpportunityOwner")
  ownedLeads                    Lead[]                   @relation("LeadOwner")
  ownedIntakeSessions           IntakeSession[]          @relation("IntakeSessionOwner")
  createdIntakeSessions         IntakeSession[]          @relation("IntakeSessionCreator")
  updatedIntakeSessions         IntakeSession[]          @relation("IntakeSessionUpdater")
  capturedIntakeAnswers         IntakeAnswer[]           @relation("IntakeAnswerCapture")
  resolvedRequirementGaps       RequirementGap[]         @relation("RequirementGapResolver")
  createdDiscoveryReports       DiscoveryReport[]        @relation("DiscoveryReportCreator")
  authorizedDiscoveryAi         DiscoveryReport[]        @relation("DiscoveryReportAiAuthorizer")
  reviewedDiscoveryReports      DiscoveryReport[]        @relation("DiscoveryReportReviewer")
  createdReportVersions         DiscoveryReportVersion[] @relation("DiscoveryReportVersionCreator")
  createdPricingWorkspaces      PricingWorkspace[]       @relation("PricingWorkspaceCreator")
  reviewedPricingWorkspaces     PricingWorkspace[]       @relation("PricingWorkspaceReviewer")
  createdPricingVersions        PricingVersion[]         @relation("PricingVersionCreator")
  createdProposalWorkspaces     ProposalWorkspace[]      @relation("ProposalWorkspaceCreator")
  reviewedProposalWorkspaces    ProposalWorkspace[]      @relation("ProposalWorkspaceReviewer")
  createdProposalVersions       ProposalVersion[]        @relation("ProposalVersionCreator")
  createdProposalDeliveries     ProposalDelivery[]       @relation("ProposalDeliveryCreator")
  createdSalesActivities        SalesActivity[]          @relation("SalesActivityCreator")
  createdSalesProposals         SalesProposal[]          @relation("SalesProposalCreator")
  timeEntries                   TimeEntry[]              @relation("TimeEntryOwner")
  timesheets                    Timesheet[]              @relation("TimesheetOwner")
  approvedTimesheets            Timesheet[]              @relation("TimesheetApprover")
  attendanceRecords             AttendanceRecord[]       @relation("AttendanceOwner")
  updatedAttendanceRecords      AttendanceRecord[]       @relation("AttendanceUpdater")
  leaveBalances                 LeaveBalance[]           @relation("LeaveBalanceOwner")
  leaveRequests                 LeaveRequest[]           @relation("LeaveRequester")
  reviewedLeaveRequests         LeaveRequest[]           @relation("LeaveReviewer")
  verifiedProjectContracts      ProjectReadiness[]       @relation("ProjectContractVerifier")
  configuredProjectPayments     ProjectReadiness[]       @relation("ProjectPaymentConfigurer")
  grantedReadinessOverrides     ProjectReadiness[]       @relation("ProjectReadinessOverrideGrantor")
  activatedProjects             ProjectReadiness[]       @relation("ProjectReadinessActivator")
  createdProjectDeliverables    ProjectDeliverable[]     @relation("ProjectDeliverableCreator")
  updatedProjectDeliverables    ProjectDeliverable[]     @relation("ProjectDeliverableUpdater")
  decidedProjectDeliverables    ProjectDeliverable[]     @relation("ProjectDeliverableDecider")
  createdProjectChangeRequests  ProjectChangeRequest[]   @relation("ProjectChangeRequestCreator")
  reviewedProjectChangeRequests ProjectChangeRequest[]   @relation("ProjectChangeRequestReviewer")
  appliedProjectChangeRequests  ProjectChangeRequest[]   @relation("ProjectChangeRequestApplier")
  ownedProjectGovernanceItems   ProjectGovernanceItem[]  @relation("ProjectGovernanceOwner")
  createdProjectGovernanceItems ProjectGovernanceItem[]  @relation("ProjectGovernanceCreator")
  updatedProjectGovernanceItems ProjectGovernanceItem[]  @relation("ProjectGovernanceUpdater")
  decidedProjectGovernanceItems ProjectGovernanceItem[]  @relation("ProjectGovernanceDecider")
  preparedProjectClosures       ProjectClosure[]         @relation("ProjectClosurePreparer")
  approvedProjectClosures       ProjectClosure[]         @relation("ProjectClosureApprover")
  ownedProjectFeedback          ProjectFeedback[]        @relation("ProjectFeedbackOwner")
  recordedProjectFeedback       ProjectFeedback[]        @relation("ProjectFeedbackRecorder")
  resolvedProjectFeedback       ProjectFeedback[]        @relation("ProjectFeedbackResolver")

  @@index([companyId])
  @@index([role])
  @@index([isActive])
}

model Session {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String  @unique
  isActive  Boolean @default(true)

  ipAddress String?
  userAgent String?

  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([userId])
  @@index([isActive])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  requestIp String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

model RateLimitBucket {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime
  expiresAt   DateTime
  updatedAt   DateTime @updatedAt

  @@index([expiresAt])
}

model Department {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name        String
  code        String
  description String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  leadProfileId String?
  leadProfile   EmployeeProfile? @relation("DepartmentLead", fields: [leadProfileId], references: [id], onDelete: SetNull)

  employeeProfiles EmployeeProfile[]
  jobRoles         JobRole[]
  teams            Team[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@index([leadProfileId])
  @@index([isActive])
  @@index([sortOrder])
}

model JobRole {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  name        String
  code        String
  description String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  employeeProfiles EmployeeProfile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@index([departmentId])
  @@index([isActive])
  @@index([sortOrder])
}

model EmployeeProfile {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  employeeNumber String?

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  jobRoleId String?
  jobRole   JobRole? @relation(fields: [jobRoleId], references: [id], onDelete: SetNull)

  managerId String?
  manager   EmployeeProfile?  @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports   EmployeeProfile[] @relation("EmployeeManager")

  employmentType   EmploymentType   @default(FULL_TIME)
  status           EmploymentStatus @default(ACTIVE)
  phone            String?
  location         String?
  workHoursPerWeek Decimal          @default(40) @db.Decimal(5, 2)
  hourlyCost       Decimal          @default(0) @db.Decimal(10, 2)
  billableRate     Decimal          @default(0) @db.Decimal(10, 2)
  startDate        DateTime?
  endDate          DateTime?

  workScheduleId String?
  workSchedule   WorkSchedule? @relation(fields: [workScheduleId], references: [id], onDelete: SetNull)

  teamMemberships    TeamMembership[]
  projectMemberships ProjectMember[]
  taskParticipations TaskParticipant[]
  ledDepartments     Department[]      @relation("DepartmentLead")
  ledTeams           Team[]            @relation("TeamLead")

  createdAt DateTime @default(now())
