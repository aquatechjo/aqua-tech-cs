model SalesOpportunity {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  serviceRequestId String? @unique
  serviceRequest   ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  projectId String? @unique
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  ownerId String?
  owner   User? @relation("SalesOpportunityOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  title       String
  contactName String
  companyName String?
  email       String?
  phone       String?
  serviceType String

  stage    SalesOpportunityStage @default(NEW)
  priority ServiceRequestPriority @default(MEDIUM)
  source   ServiceRequestSource   @default(MANUAL)

  estimatedValue Decimal @default(0) @db.Decimal(14, 2)
  currency       String  @default("JOD")
  probability    Int     @default(10)

  expectedCloseDate DateTime?
  nextFollowUpAt   DateTime?
  lastContactAt    DateTime?

  lostReason String?
  notes      String?
  wonAt      DateTime?
  lostAt     DateTime?

  activities SalesActivity[]
  proposals  SalesProposal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([clientId])
  @@index([projectId])
  @@index([ownerId])
  @@index([stage])
  @@index([priority])
  @@index([source])
  @@index([expectedCloseDate])
  @@index([nextFollowUpAt])
  @@index([updatedAt])
}

