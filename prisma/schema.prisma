  createdBy   User?   @relation("DiscoveryReportVersionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  version Int
  origin  DiscoveryReportVersionOrigin
  content Json

  contentHash       String
  evidenceSnapshot  Json
  evidenceInputHash String
  promptVersion     String?
  aiProvider        String?
  aiModel           String?
  aiResponseId      String?

  createdAt DateTime @default(now())

  @@unique([reportId, version])
  @@index([companyId])
  @@index([createdById])
  @@index([origin])
  @@index([evidenceInputHash])
  @@index([createdAt])
}

model PricingWorkspace {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  intakeSessionId String        @unique
  intakeSession   IntakeSession @relation(fields: [intakeSessionId], references: [id], onDelete: Cascade)

  discoveryReportId String          @unique
  discoveryReport   DiscoveryReport @relation(fields: [discoveryReportId], references: [id], onDelete: Cascade)

  opportunityId String?           @unique
  opportunity   SalesOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("PricingWorkspaceCreator", fields: [createdById], references: [id], onDelete: SetNull)

  reviewedById String?
  reviewedBy   User?   @relation("PricingWorkspaceReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  status         PricingWorkspaceStatus @default(DRAFT)
  currentVersion Int                    @default(0)
  reviewNotes    String?

  submittedAt        DateTime?
  changesRequestedAt DateTime?
  approvedAt         DateTime?

  versions          PricingVersion[]
  proposalWorkspace ProposalWorkspace?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([createdById])
  @@index([reviewedById])
  @@index([status])
  @@index([updatedAt])
}

model PricingVersion {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   PricingWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation("PricingVersionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  version Int
  content Json

  contentHash            String
  discoveryReportVersion Int
  discoveryContentHash   String

  createdAt DateTime @default(now())

  @@unique([workspaceId, version])
  @@index([companyId])
  @@index([createdById])
  @@index([discoveryContentHash])
  @@index([createdAt])
}

model ProposalWorkspace {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  intakeSessionId String        @unique
  intakeSession   IntakeSession @relation(fields: [intakeSessionId], references: [id], onDelete: Cascade)

  pricingWorkspaceId String           @unique
  pricingWorkspace   PricingWorkspace @relation(fields: [pricingWorkspaceId], references: [id], onDelete: Cascade)

  opportunityId String?           @unique
  opportunity   SalesOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("ProposalWorkspaceCreator", fields: [createdById], references: [id], onDelete: SetNull)

  reviewedById String?
  reviewedBy   User?   @relation("ProposalWorkspaceReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  proposalNumber String
  status         ProposalWorkspaceStatus @default(DRAFT)
  currentVersion Int                     @default(0)
  reviewNotes    String?

  submittedAt           DateTime?
  changesRequestedAt    DateTime?
  approvedAt            DateTime?
  sentVersion           Int?
  sentClientContentHash String?
  sentAt                DateTime?
  clientRespondedAt     DateTime?
  clientResponseName    String?
  clientResponseEmail   String?
  clientResponseTitle   String?
  clientResponseNotes   String?

  versions         ProposalVersion[]
  deliveries       ProposalDelivery[]
  responses        ProposalClientResponse[]
  convertedProject Project?                 @relation("ProposalConvertedProject")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, proposalNumber])
  @@index([companyId])
  @@index([createdById])
  @@index([reviewedById])
  @@index([status])
  @@index([sentAt])
  @@index([clientRespondedAt])
  @@index([updatedAt])
}

model ProposalVersion {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   ProposalWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation("ProposalVersionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  version Int
  content Json

  contentHash            String
  clientContentHash      String
  pricingVersion         Int
  pricingContentHash     String
  discoveryReportVersion Int
  discoveryContentHash   String

  createdAt DateTime @default(now())

  @@unique([workspaceId, version])
  @@index([companyId])
  @@index([createdById])
  @@index([pricingContentHash])
  @@index([discoveryContentHash])
  @@index([createdAt])
}

model ProposalDelivery {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   ProposalWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation("ProposalDeliveryCreator", fields: [createdById], references: [id], onDelete: SetNull)

  channel ProposalDeliveryChannel
  status  ProposalDeliveryStatus  @default(PREPARED)

  version           Int
  clientContentHash String

  recipientName  String?
  recipientEmail String?
  recipientPhone String?

  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?

  providerMessageId String?
  failureCode       String?
  failureMessage    String?

  preparedAt    DateTime  @default(now())
  sentAt        DateTime?
  firstViewedAt DateTime?
  lastViewedAt  DateTime?
  viewCount     Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responses ProposalClientResponse[]

  @@index([companyId])
  @@index([workspaceId])
  @@index([createdById])
  @@index([status])
  @@index([expiresAt])
  @@index([sentAt])
}

model ProposalClientResponse {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   ProposalWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  deliveryId String
  delivery   ProposalDelivery @relation(fields: [deliveryId], references: [id], onDelete: Restrict)

  version           Int
  clientContentHash String
  decision          ProposalClientDecision

  responderName      String
  responderEmail     String
  responderTitle     String?
  notes              String?
  authorityConfirmed Boolean

  ipAddress        String?
  userAgent        String?
  respondedAt      DateTime @default(now())
  convertedProject Project? @relation("ProposalResponseConvertedProject")

  @@unique([workspaceId, version])
  @@index([companyId])
  @@index([deliveryId])
  @@index([decision])
  @@index([respondedAt])
}

model SalesActivity {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  opportunityId String
  opportunity   SalesOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation("SalesActivityCreator", fields: [createdById], references: [id], onDelete: SetNull)

  type    SalesActivityType
  status  SalesActivityStatus @default(PLANNED)
  subject String
  details String?
  outcome String?

  scheduledAt DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([opportunityId])
  @@index([createdById])
  @@index([type])
  @@index([status])
  @@index([scheduledAt])
  @@index([completedAt])
}

model SalesProposal {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  opportunityId String
  opportunity   SalesOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation("SalesProposalCreator", fields: [createdById], references: [id], onDelete: SetNull)

  proposalNumber String
  version        Int
  status         SalesProposalStatus @default(DRAFT)
  title          String
  amount         Decimal             @db.Decimal(14, 2)
  currency       String              @default("JOD")

  validUntil DateTime?
  url        String?
  notes      String?

  sentAt     DateTime?
  acceptedAt DateTime?
  rejectedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, proposalNumber])
  @@unique([opportunityId, version])
  @@index([companyId])
  @@index([opportunityId])
  @@index([createdById])
  @@index([status])
  @@index([validUntil])
}

