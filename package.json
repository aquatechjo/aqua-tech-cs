{
  "name": "aqua-tech-cs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate \u0026\u0026 next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen \u0026\u0026 tsc --noEmit --pretty false",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "check": "npm run prisma:generate \u0026\u0026 npm run ds:check \u0026\u0026 npm run lint \u0026\u0026 npm run typecheck \u0026\u0026 npm run test:unit \u0026\u0026 npm run build",
    "prisma:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate",
    "ds:sync": "node scripts/sync-aqua-design-system.mjs",
    "ds:check": "node scripts/sync-aqua-design-system.mjs --check",
    "ds:starter": "node scripts/create-aqua-product-starter.mjs",
    "ds:visual:update": "node scripts/update-aqua-visual-baseline.mjs",
    "test:visual": "node --import tsx --test tests/unit/design-system-visual.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "bcryptjs": "^3.0.3",
    "bootstrap": "^5.3.8",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "flatpickr": "^4.6.13",
    "lucide-react": "^1.21.0",
    "next": "16.2.11",
    "pg": "^8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "eslint-config-prettier": "^9.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.6",
    "prisma": "7.9.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^5"
  },
  "overrides": {
    "find-my-way": "9.7.0",
    "postcss": "8.5.22",
    "sharp": "0.35.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,scss,md,mdx,yml,yaml}": [
      "prettier --write"
    ]
  }
}
